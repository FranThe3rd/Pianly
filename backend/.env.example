# Railway injects PORT and PG* vars automatically when Postgres is linked.

# Required — base64 HMAC key: openssl rand -base64 64
JWT_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend origin for CORS + Stripe redirect URLs
FRONTEND_URL=https://www.pianly.net

# Optional extra CORS origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://pianly.net,https://www.pianly.net

# Or set full JDBC URL if Railway PG* vars are not linked:
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/railway

# Optional
JPA_DDL_AUTO=update
