# Railway injects PORT and PG* vars automatically when Postgres is linked.

# Required
JWT_SECRET_KEY=your-long-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend origin for CORS + Stripe redirect URLs
FRONTEND_URL=https://pianly.net

# Optional
JPA_DDL_AUTO=update
